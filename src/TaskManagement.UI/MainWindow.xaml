<Window x:Class="TaskManagement.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskManagement.UI.ViewModels"
    xmlns:conv="clr-namespace:TaskManagement.UI.Converters"
    xmlns:controls="clr-namespace:TaskManagement.UI.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="Task Management"
    Height="760"
    Width="1320"
    MinHeight="560"
    MinWidth="1040"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource AppBackgroundBrush}"
    Foreground="{StaticResource TextBrush}"
    FontFamily="Segoe UI"
    FontSize="13"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />
        <conv:InitialsConverter x:Key="Initials" />
        <conv:StatusTextConverter x:Key="StatusText" />

        <DataTemplate x:Key="Avatar">
            <Grid Width="36" Height="36">
                <Ellipse x:Name="Circle" Fill="#E0E5F6" />
                <TextBlock x:Name="InitialsText" Text="{Binding FullName, Converter={StaticResource Initials}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter TargetName="Circle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="Circle" Property="Fill" Value="#E5E7EB" />
                    <Setter TargetName="InitialsText" Property="Foreground" Value="#9CA3AF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#E3ECFF" />
            <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Background" Value="#FFF3D6" />
                    <Setter Property="TextElement.Foreground" Value="#92400E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OnHold">
                    <Setter Property="Background" Value="#EEF0F3" />
                    <Setter Property="TextElement.Foreground" Value="#4B5563" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#DFF5E5" />
                    <Setter Property="TextElement.Foreground" Value="#166534" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="#FDECEC" />
                    <Setter Property="TextElement.Foreground" Value="#991B1B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CounterChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#EEF1F8" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.2" />
                </Border.Effect>
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBoard}" Stroke="White" StrokeThickness="1.4" Stretch="Uniform"
                              Width="26" Height="26" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                Text="Task Management"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="3" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        MaxWidth="720" Margin="0,0,0,8" Padding="12,6" CornerRadius="8"
                        Background="{StaticResource ErrorBackgroundBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding DismissErrorCommand}" Style="{StaticResource IconButton}"
                                Width="28" Height="28" Foreground="{StaticResource ErrorForegroundBrush}" ToolTip="Dismiss">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIcon}" />
                        </Button>
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource ErrorForegroundBrush}" />
                            <TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding ErrorMessage}" Margin="10,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{StaticResource ErrorForegroundBrush}" />
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Employees" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Select an assignee to see their tasks" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                                 ItemContainerStyle="{StaticResource EmployeeItem}"
                                 BorderThickness="0" Background="Transparent" Margin="-8,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}" />
                                        <StackPanel x:Name="Info" Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Position}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border x:Name="InactiveBadge" Grid.Column="2" Background="#EEF0F3" CornerRadius="9"
                                                Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="Inactive" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="InactiveBadge" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Info" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </ContentControl>

                <ContentControl Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource CounterChip}">
                                    <TextBlock><Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" total" /></TextBlock>
                                </Border>
                                <Border
                                    Style="{StaticResource CounterChip}">
                                    <TextBlock><Run
                                            Text="{Binding OpenCount, Mode=OneWay}"
                                            FontWeight="SemiBold" /><Run
                                            Text=" open" /></TextBlock>
                                </Border>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CounterChip}">
                                            <Setter Property="Background" Value="#FDECEC" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource OverdueBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                                    <Setter Property="Background" Value="#EEF1F8" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock><Run Text="{Binding OverdueCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" overdue" /></TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="{Binding SelectedEmployee}" ContentTemplate="{StaticResource Avatar}" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEmployee.FullName}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding SelectedEmployee.Position}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Change status" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding ChangeStatusCommand}" Content="Apply"
                                            Style="{StaticResource PrimaryButton}" MinWidth="96" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <controls:StatusSelector CurrentStatus="{Binding SelectedTask.Status, FallbackValue={x:Null}}"
                                                             SelectedStatus="{Binding NewStatus}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="Task" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AssignedByName, StringFormat=Assigned by {0}}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                        <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Status" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Border Style="{StaticResource StatusPill}">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="12" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock x:Name="CompletedText" Margin="2,3,0,0" Style="{StaticResource MutedText}" Visibility="Collapsed"
                                                               Text="{Binding CompletedAt, Converter={StaticResource UtcToLocal}, StringFormat=on {0:dd MMM, HH:mm}}" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter TargetName="CompletedText" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Planned start" Width="110" ElementStyle="{StaticResource CellText}"
                                                        Binding="{Binding PlannedStartAt, Converter={StaticResource UtcToLocal}, StringFormat=dd MMM yyyy}" />

                                    <DataGridTemplateColumn Header="Due" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid x:Name="OverdueIcon" Width="15" Height="15" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Overdue">
                                                        <Ellipse Fill="{StaticResource OverdueBrush}" />
                                                        <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="DueText" VerticalAlignment="Center"
                                                               Text="{Binding DueAt, Converter={StaticResource UtcToLocal}, StringFormat=dd MMM yyyy}" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter TargetName="OverdueIcon" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="DueText" Property="Foreground" Value="{StaticResource OverdueBrush}" />
                                                        <Setter TargetName="DueText" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource IconBoard}" Stroke="#C7CCD6" StrokeThickness="1" Stretch="Uniform"
                                      Width="44" Height="44" HorizontalAlignment="Center" StrokeLineJoin="Round" />
                                <TextBlock Text="No tasks yet" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="15"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="Create one using the form on the right" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </ContentControl>

                <ContentControl Grid.Column="2" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="New task" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Assigned to the selected employee" Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                            <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding SelectedEmployee}" ContentTemplate="{StaticResource Avatar}" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Assignee" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding SelectedEmployee.FullName}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Assigned by" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding NewAssignedBy}" Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,12" />

                            <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewDescription}" MaxLength="2000" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Planned start" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding NewPlannedStart}" CalendarClosed="OnDatePickerCalendarClosed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Due" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding NewDue}" CalendarClosed="OnDatePickerCalendarClosed" />
                                </StackPanel>
                            </Grid>

                            <Button Command="{Binding CreateTaskCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Fill="White" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Create task" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </ContentControl>
            </Grid>
        </DockPanel>

    </Grid>
</Window>