<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TaskManagement.UI.Controls">

    <Style x:Key="StatusOptionButton" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#D7DCE5" />
        <Setter Property="Foreground" Value="#1F2937" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,3,6,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#9AA5BC" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3F51B5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:StatusSelector}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusSelector}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup
                                x:Name="AvailabilityStates">
                                <VisualState x:Name="NoTask">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Options" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Editable" />
                                <VisualState x:Name="Locked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LockIcon" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15" />
                                </VisualStateGroup.Transitions>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ItemsControl x:Name="Options" VerticalAlignment="Center" ItemsSource="{TemplateBinding Options}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controls:StatusOption}">
                                    <Button x:Name="Option" Style="{StaticResource StatusOptionButton}"
                                            Command="{x:Static controls:StatusSelector.SelectCommand}"
                                            CommandParameter="{Binding Status}"
                                            AutomationProperties.Name="{Binding Text}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="CurrentMark" Text=" · current" Foreground="#6B7280" Visibility="Collapsed" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                            <Setter TargetName="Dot" Property="Fill" Value="#F59E0B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="OnHold">
                                            <Setter TargetName="Dot" Property="Fill" Value="#9CA3AF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                            <Setter TargetName="Dot" Property="Fill" Value="#22A04B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter TargetName="Dot" Property="Fill" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="CurrentMark" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Option" Property="Opacity" Value="1" />
                                            <Setter TargetName="Option" Property="Background" Value="#F3F5F9" />
                                            <Setter TargetName="Option" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Option" Property="Background" Value="#3F51B5" />
                                            <Setter TargetName="Option" Property="BorderBrush" Value="#3F51B5" />
                                            <Setter TargetName="Option" Property="Foreground" Value="White" />
                                            <Setter TargetName="Dot" Property="Stroke" Value="White" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="LockIcon" Grid.Column="1" Visibility="Collapsed" Background="Transparent"
                                VerticalAlignment="Center" Margin="2,0,0,0"
                                ToolTip="Completed and Cancelled are final statuses: this task can no longer change">
                            <Path Data="M5,7.5 L5,5.5 A3,3 0 0 1 11,5.5 L11,7.5 M3.5,7.5 L12.5,7.5 L12.5,14 L3.5,14 Z"
                                  Width="16" Height="16" Stroke="#A32020" StrokeThickness="1.4" StrokeLineJoin="Round" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>